# Local secrets and settings for gpt-y-fbb. This file is gitignored. Copy to .env.example without values.

# --- Web app login (HTTP Basic Auth shared with the league) ---
WEB_AUTH_USER=
# New password generated 2026-11-12 (the old one was in a committed-looking doc, treat it as exposed).
# Plaintext kept here only so you can share it with the league:
WEB_AUTH_PASSWORD=
# Hash of the same password; the app uses this and never the plaintext.
WEB_AUTH_PASSWORD_HASH=

# --- Yahoo Fantasy ---
YAHOO_OAUTH_FILE=
# Cloud sessions (no oauth2.json on disk): paste the whole contents of a linked oauth2.json here instead.
YAHOO_OAUTH_JSON=
# 2026-27 season league id is 17275 (the 2025-26 league was 466.l.10145). Game key is resolved at runtime.
FANTASY_LEAGUE_ID=
# Leave empty to use the team Yahoo reports as yours.
FANTASY_TEAM_KEY=

# --- Hashtag Basketball premium (hashtag+) ---
HASHTAG_EMAIL=
HASHTAG_PASSWORD=
HASHTAG_LEAGUE_ID=

# --- Runtime ---
TIMEZONE=
FLASK_DEBUG=
PORT=
